<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="OnLoaded"
        MouseEnter="OnPointerActivity"
        MouseMove="OnMouseMove"
        MouseLeftButtonDown="OnLeftDown"
        MouseLeftButtonUp="OnLeftUp"
        MouseRightButtonUp="OnRightUp"
        MouseWheel="OnWheel">

    <!--
        四个关键属性:
          WindowStyle=None       去标题栏和边框
          AllowsTransparency     开逐像素 alpha 的分层窗口
          Background={x:Null}    null(而不是 Transparent)=空白处不参与命中测试,鼠标穿透到底下
          ShowInTaskbar=False    不占任务栏
    -->

    <Window.Resources>

        <!-- 待机: 上下轻微浮动,永远循环 -->
        <Storyboard x:Key="FloatLoop" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Float"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 眨一下眼 -->
        <Storyboard x:Key="Blink">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlinkL" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.08"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.16" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BlinkR" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.07" Value="0.08"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.16" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 被点了: 压扁再弹回来 -->
        <Storyboard x:Key="Squish">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="1.16"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.84"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="4"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 睡着: 闭眼 -->
        <Storyboard x:Key="EyesClose">
            <DoubleAnimation Storyboard.TargetName="BlinkL" Storyboard.TargetProperty="ScaleY"
                             To="0.08" Duration="0:0:0.35" FillBehavior="HoldEnd"/>
            <DoubleAnimation Storyboard.TargetName="BlinkR" Storyboard.TargetProperty="ScaleY"
                             To="0.08" Duration="0:0:0.35" FillBehavior="HoldEnd"/>
        </Storyboard>

        <Storyboard x:Key="EyesOpen">
            <DoubleAnimation Storyboard.TargetName="BlinkL" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.18" FillBehavior="HoldEnd"/>
            <DoubleAnimation Storyboard.TargetName="BlinkR" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.18" FillBehavior="HoldEnd"/>
        </Storyboard>

        <!-- 睡着: 冒 Zzz -->
        <Storyboard x:Key="ZzzLoop" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Zzz" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.95"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2.0" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="ZzzRise" Storyboard.TargetProperty="Y"
                             From="0" To="-22" Duration="0:0:2.0"/>
        </Storyboard>

        <Storyboard x:Key="ZzzHide">
            <DoubleAnimation Storyboard.TargetName="Zzz" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2" FillBehavior="HoldEnd"/>
        </Storyboard>

        <!-- 气泡弹出: 从小弹到大,带一点回弹 -->
        <Storyboard x:Key="BubbleIn">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BubblePop" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.7"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BubblePop" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.7"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.7"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

    </Window.Resources>

    <!-- LayoutTransform 做用户缩放(影响布局,窗口跟着变大),RenderTransform 留给动画 -->
    <Canvas x:Name="Stage" Width="160" Height="176">
        <Canvas.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
        </Canvas.LayoutTransform>

        <!-- 地面投影,不跟着身体浮动,所以放在 Body 外面 -->
        <Ellipse Canvas.Left="38" Canvas.Top="152" Width="84" Height="18" Opacity="0.32">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Canvas x:Name="Body" Width="160" Height="176" RenderTransformOrigin="0.5,0.9">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Float" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 耳朵(在鬃毛后面) -->
            <Ellipse Canvas.Left="12"  Canvas.Top="18" Width="38" Height="38" Fill="#E8892B"/>
            <Ellipse Canvas.Left="110" Canvas.Top="18" Width="38" Height="38" Fill="#E8892B"/>
            <Ellipse Canvas.Left="21"  Canvas.Top="27" Width="20" Height="20" Fill="#C96A1E"/>
            <Ellipse Canvas.Left="119" Canvas.Top="27" Width="20" Height="20" Fill="#C96A1E"/>

            <!-- 鬃毛 -->
            <Ellipse Canvas.Left="14" Canvas.Top="22" Width="132" Height="132">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#FFF9BD5E" Offset="0"/>
                        <GradientStop Color="#FFE8892B" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 脸 -->
            <Ellipse Canvas.Left="34" Canvas.Top="44" Width="92" Height="86" Fill="#FFF3DC">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#8A5A20" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 腮红 -->
            <Ellipse Canvas.Left="41"  Canvas.Top="94" Width="20" Height="12" Fill="#FF8E7A" Opacity="0.45"/>
            <Ellipse Canvas.Left="99"  Canvas.Top="94" Width="20" Height="12" Fill="#FF8E7A" Opacity="0.45"/>

            <!-- 眼睛: ScaleY 被 Blink/EyesClose 动画驱动 -->
            <Ellipse Canvas.Left="55" Canvas.Top="72" Width="13" Height="17"
                     Fill="#3A2A18" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="BlinkL" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="92" Canvas.Top="72" Width="13" Height="17"
                     Fill="#3A2A18" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="BlinkR" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="58" Canvas.Top="75" Width="5" Height="5" Fill="White" IsHitTestVisible="False"/>
            <Ellipse Canvas.Left="95" Canvas.Top="75" Width="5" Height="5" Fill="White" IsHitTestVisible="False"/>

            <!-- 鼻子 + 嘴 -->
            <Path Fill="#6B4A2A" Data="M72,96 L88,96 L80,105 Z"/>
            <Path Stroke="#6B4A2A" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M80,105 L80,110 M80,110 Q73.5,117 67,110 M80,110 Q86.5,117 93,110"/>

            <!-- 前爪 -->
            <Ellipse Canvas.Left="40" Canvas.Top="138" Width="34" Height="19"
                     Fill="#F9BD5E" Stroke="#D97B22" StrokeThickness="1.5"/>
            <Ellipse Canvas.Left="86" Canvas.Top="138" Width="34" Height="19"
                     Fill="#F9BD5E" Stroke="#D97B22" StrokeThickness="1.5"/>

        </Canvas>

        <!--
            有没读过的警告时，左上角挂个红点。
            放左边不放右边：右边 14,116 那块留给睡觉的 Zzz，两个挤一起谁也看不清。
            IsHitTestVisible=False —— 它只是个标记，点它应该和点小狮子是一回事。
        -->
        <Grid x:Name="AlertBadge" Canvas.Left="4" Canvas.Top="0"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse Width="26" Height="26" Fill="#B3382C">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#7A1810" BlurRadius="8" ShadowDepth="1" Opacity="0.45"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="AlertBadgeText" Text="!"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                       Foreground="White"/>
        </Grid>

        <!-- 睡着时冒出来的 Zzz -->
        <TextBlock x:Name="Zzz" Canvas.Left="116" Canvas.Top="14" Opacity="0"
                   Text="z Z" FontSize="21" FontWeight="Bold" Foreground="#6F9FD8"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="ZzzRise" Y="0"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!--
            说话气泡。
            用 Popup 而不是直接画在窗口里：Popup 是独立的 HWND，气泡多宽多高都不会
            撑大宠物窗口、也不会因为 SizeToContent 把宠物的屏幕位置挤走。
            Placement 在代码里用 CustomPopupPlacementCallback 做水平居中。
        -->
        <Popup x:Name="Bubble"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               PopupAnimation="Fade"
               Placement="Custom">
            <Grid Margin="14,14,14,4" IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BubblePop" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <StackPanel>
                    <!--
                        描边颜色在代码里切：平时是小狮子那个橙 #E8892B，
                        报警时换成看板的警示红 #B3382C。两处（框和尖角）得一起换，
                        所以都起了名字。
                    -->
                    <Border x:Name="BubbleBox" CornerRadius="14" Background="White"
                            BorderBrush="#E8892B" BorderThickness="1.6" Padding="14,9">
                        <Border.Effect>
                            <DropShadowEffect Color="#7A4A10" BlurRadius="14" ShadowDepth="2" Opacity="0.32"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- 报警时在气泡顶上加一行小字，说明这不是闲聊 -->
                            <TextBlock x:Name="BubbleTag" Visibility="Collapsed"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="10.5" FontWeight="Bold"
                                       Foreground="#B3382C" Margin="0,0,0,3" Text="本班警告"/>
                            <TextBlock x:Name="BubbleText"
                                       MaxWidth="215" TextWrapping="Wrap"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="13.5" LineHeight="20"
                                       Foreground="#3A2A18" Text="…"/>
                            <TextBlock x:Name="BubbleHint" Visibility="Collapsed"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="10.5" Foreground="#9AA0A6"
                                       Margin="0,4,0,0" Text="点我看 AI 解析"/>
                        </StackPanel>
                    </Border>
                    <!-- 尖角：先用白色实心三角盖住上面那条描边，再画两条斜边 -->
                    <Grid HorizontalAlignment="Center" Width="20" Height="11" Margin="0,-2,0,0">
                        <Path Fill="White" Data="M0,0 L10,11 L20,0 Z"/>
                        <Path x:Name="BubbleTail" Stroke="#E8892B" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M0,0 L10,11 L20,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Popup>

    </Canvas>
</Window>
