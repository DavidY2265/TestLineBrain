<UserControl x:Class="DesktopPet.Ui.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        追问对话框。一份控件，四个地方摆：三栏的 AI 解读报告下面，
        和小精灵报警点开的解析下面。每摆一个就是一个独立实例，各聊各的不串台。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 「还能问什么」 -->
            <RowDefinition Height="*"/>      <!-- 消息 -->
            <RowDefinition Height="Auto"/>   <!-- 建议问题 -->
            <RowDefinition Height="Auto"/>   <!-- 输入 -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource HairBrush}" BorderThickness="0,1,0,1"
                Padding="14,7,14,7">
            <TextBlock x:Name="HintText" FontSize="10.5"
                       Foreground="{StaticResource SoftBrush}"
                       TextWrapping="Wrap" Text="—"/>
        </Border>

        <!--
            消息列表。ScrollViewer 里放 StackPanel：StackPanel 的高度由内容决定，
            装不下就由外面的 ScrollViewer 滚 —— 反过来（ScrollViewer 放 StackPanel 里）
            会因为拿到无限高度而量不出该多高。
        -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,8,14,8">
            <StackPanel x:Name="Messages"/>
        </ScrollViewer>

        <!-- 建议问题：点一下直接问，保证问得到有答案的东西 -->
        <Border Grid.Row="2" Padding="14,4,14,0">
            <WrapPanel x:Name="Chips"/>
        </Border>

        <Border Grid.Row="3" Padding="14,8,14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Input" Grid.Column="0"
                         Style="{StaticResource ChatInput}"
                         MinHeight="34" MaxHeight="90"
                         PreviewKeyDown="OnInputKeyDown"/>

                <Button x:Name="SendButton" Grid.Column="1" Content="发送"
                        Style="{StaticResource AiButton}"
                        Margin="8,0,0,0" VerticalAlignment="Bottom" Height="34"
                        Click="OnSendClick"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
