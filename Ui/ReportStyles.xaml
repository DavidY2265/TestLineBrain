<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        AI 解读报告的排版样式。**只有样式，没有正文。**

        这个文件原来叫 Reports.xaml，里面还躺着设备报警和锁附两份写死的
        FlowDocument —— 设计阶段的样稿，「本班整线停机 51 min，MA 86.8%」
        这些数字全是手敲的。结果数据库一条记录都没读到，点「AI 解读」
        照样弹出一份有鼻子有眼的报告，和旁边表格里的数还对不上。
        那两份已经删掉，三栏的正文现在全部由 AlarmReport / FastenReport /
        TestReport 从当前数据现拼（见 ReportWindow.BuildDoc）。

        为什么正文用 FlowDocument 而不是一堆 TextBlock：报告是流式文字，
        段落、加粗强调都是现成的，还自带选中复制和换行重排，窗口一窄自己重新断行。

        报警解析弹窗也借这一套样式，所以它和三份报告长得是一家人。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BrainTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================ 排版 -->


    <!-- 抬头：标题 + 一行生成信息，下面压一条细线 -->
    <Style x:Key="RepHead" TargetType="Paragraph">
        <Setter Property="Margin"          Value="0,0,0,4"/>
        <Setter Property="Padding"         Value="0,0,0,11"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource HairBrush}"/>
    </Style>

    <Style x:Key="RepTitle" TargetType="Run">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <Style x:Key="RepMeta" TargetType="Run">
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}"/>
    </Style>

    <!-- 小节标题 -->
    <Style x:Key="RepH" TargetType="Paragraph">
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}"/>
        <Setter Property="Margin"     Value="0,16,0,6"/>
    </Style>

    <!-- 正文段落。行高 1.78 倍，和 HTML 稿一致 -->
    <Style x:Key="RepP" TargetType="Paragraph">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="LineHeight" Value="21.4"/>
        <Setter Property="Foreground" Value="{StaticResource MidBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <!-- 段落里被强调的词，比正文更黑 -->
    <Style x:Key="RepB" TargetType="Run">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <!-- 页脚免责 -->
    <Style x:Key="RepFoot" TargetType="Paragraph">
        <Setter Property="FontSize"        Value="10.5"/>
        <Setter Property="LineHeight"      Value="18"/>
        <Setter Property="Foreground"      Value="{StaticResource FaintBrush}"/>
        <Setter Property="Margin"          Value="0,18,0,0"/>
        <Setter Property="Padding"         Value="0,11,0,0"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush"     Value="{StaticResource HairBrush}"/>
    </Style>

    <!-- ============================================================ 设备报警 -->
    <!--
        这一份 HTML 稿里没有，是新写的。所有数字取自 BrainData 的同一份报警记录：
        31 次 / 合计 58 / 并集 51 / 重叠 7 / MA 86.8% / 班次 386。
    -->

</ResourceDictionary>
