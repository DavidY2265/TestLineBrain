<Window x:Class="DesktopPet.Ui.BrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:DesktopPet.Ui"
        Title="产线智能大脑" Width="1120" Height="760"
        MinWidth="900" MinHeight="520"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Panel2Brush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource HairBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================ 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource DarkBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="18,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               Text="产线智能大脑"/>

                    <TextBlock x:Name="SubtitleText"
                               Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="#8B9096"
                               TextTrimming="CharacterEllipsis" Text="—"/>

                    <!-- 读数据时发现的毛病（缺文件、缺列、限值变更舍弃了数据…）。
                         没毛病就整个藏起来；有毛病必须让人一眼看见 ——
                         一堆算错的数看起来和算对的一模一样，人不会主动怀疑。
                         鼠标停上去看全文。 -->
                    <Border x:Name="ProblemChip" Grid.Column="2" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="#3A1E1E" BorderBrush="#7A3030" BorderThickness="1"
                            CornerRadius="3" Padding="8,2"
                            Cursor="Hand" MouseLeftButtonUp="OnProblemChipClick">
                        <TextBlock x:Name="ProblemText" FontSize="10.5" Foreground="#E88A8A"/>
                    </Border>

                    <!-- 点开看全文。
                         原来只挂了 ToolTip：鼠标一动就没，长句子读不完，
                         而且没人知道这块红色是可以停上去的。既然它报的是
                         「你的数不可信」，就不该藏在一个要靠猜的交互里。 -->
                    <Popup x:Name="ProblemPopup" PlacementTarget="{Binding ElementName=ProblemChip}"
                           Placement="Bottom" HorizontalOffset="-220" VerticalOffset="6"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4"
                                BorderBrush="{StaticResource HairBrush}" BorderThickness="1"
                                Padding="16,13" MaxWidth="470">
                            <StackPanel>
                                <TextBlock Text="数据问题" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,3"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                           Foreground="{StaticResource MidBrush}"
                                           Text="下面这些地方没取到数据。相关那一栏显示的是「—」而不是 0 —— 没取到不等于没问题发生。"/>
                                <ItemsControl x:Name="ProblemList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                       FontSize="11.5" Margin="0,0,0,7"
                                                       Foreground="{StaticResource InkBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ProblemFoot" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,4,0,0" Foreground="{StaticResource MidBrush}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="3" Style="{StaticResource CloseX}"
                            Margin="0,0,7,0" VerticalAlignment="Center"
                            Click="OnCloseClick"/>
                </Grid>
            </Border>

            <!-- ============================================ 三个页签 -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">

                    <RadioButton x:Name="TabEq" GroupName="BrainTab"
                                 Style="{StaticResource TabButton}"
                                 Checked="OnTabEqChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备报警" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource TabPill}">
                                <TextBlock x:Name="TabEqCount" Text="—" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabMq" GroupName="BrainTab"
                                 Style="{StaticResource TabButton}"
                                 Content="锁附工艺"
                                 Checked="OnTabMqChecked"/>

                    <RadioButton x:Name="TabTe" GroupName="BrainTab"
                                 Style="{StaticResource TabButton}"
                                 Content="测试"
                                 Checked="OnTabTeChecked"/>

                </StackPanel>
            </Border>

            <!-- ============================================ 内容 -->
            <!--
                三栏一次性全建出来，切页签只改 Visibility。
                表都是静态的，留在内存里比每次重建便宜，滚动位置也不会丢。

                这里是 Border 不是 ScrollViewer：滚动条挪进每张卡片里面了。
                外面一个大滚动条的话，卡片高度得跟着内容走，报警多两条整个板面
                就往下顶一截；现在每张卡片占的位置由窗口定死，内容多了卡片内部滚。

                Padding 左右两边由 OnBoardSizeChanged 改：21.5 寸全屏是 1920 宽，
                板面铺满那么宽的话，品质和良率那两张密集的数字表会被扯开一大截。
            -->
            <Border x:Name="Board" Grid.Row="2"
                    Padding="18,16,18,20"
                    SizeChanged="OnBoardSizeChanged">
                <!-- 三个面板在 code-behind 里建。
                     它们的构造要接一个 ShiftData（本班数据从上面传下来），
                     XAML 只会调无参构造，所以这里只留一个空容器。 -->
                <Grid x:Name="PaneHost"/>
            </Border>

        </Grid>
    </Border>
</Window>
