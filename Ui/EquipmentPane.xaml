<UserControl x:Class="DesktopPet.Ui.EquipmentPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Grid 不是 StackPanel：KPI 条按内容高，卡片吃掉剩下的全部高度。
        这样报警多两条少两条，卡片还在原地，只是里面滚。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= 六个 KPI -->
        <!--
            MA、整线停机、重叠三个数留空，由 BrainData 从那一份报警记录算出来填进去。
            写死的话改一个发生时刻就对不上了。
        -->
        <Border Grid.Row="0" Style="{StaticResource KpiStrip}" Margin="0,0,0,14">
            <UniformGrid Columns="6">

                <Border Style="{StaticResource KpiCellFirst}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="整线 MA"/>
                        <TextBlock x:Name="KpiMa" Style="{StaticResource KpiValueCrit}" Text="—"/>
                        <TextBlock x:Name="KpiMaDesc" Style="{StaticResource KpiDescAlert}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="整线停机时长"/>
                        <TextBlock Style="{StaticResource KpiValueCrit}">
                            <Run x:Name="KpiUnionRun" Text="—"/><Run Style="{StaticResource KpiUnit}" Text=" min"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource KpiDescAlert}" Text="全部报警区间并集"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="各条报警时长合计"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run x:Name="KpiSumRun" Text="—"/><Run Style="{StaticResource KpiUnit}" Text=" min"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource KpiDesc}">
                            <Run Text="含同时报警重叠 "/><Run x:Name="KpiOverlapRun" Text="—"/><Run Text=" min"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="报警次数"/>
                        <TextBlock x:Name="KpiCount" Style="{StaticResource KpiValueWarn}" Text="—"/>
                        <TextBlock x:Name="KpiCountDesc" Style="{StaticResource KpiDescAlert}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="最差站别"/>
                        <TextBlock x:Name="KpiWorstSt" Style="{StaticResource KpiValueWarn}" Text="—"/>
                        <TextBlock x:Name="KpiWorstStDesc" Style="{StaticResource KpiDescAlert}" Text="—"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiKey}" Text="数据缺失"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run x:Name="KpiNoDataRun" Text="—"/><Run Style="{StaticResource KpiUnit}" Text=" min"/>
                        </TextBlock>
                        <TextBlock x:Name="KpiNoDataDesc" Style="{StaticResource KpiDesc}" Text="—"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </Border>

        <!-- ================================================= 报警汇总表 -->
        <!--
            时间轴不再单独占一张卡片：它就是表的最后一列。
            原来两处各写一遍站别和报警内容，合成一张表以后只剩一遍，
            表尾那行「整线」是各台区间的并集，不是上面几行相加。
        -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}"
                                   Text="本班报警汇总　站别 × 报警内容"/>
                        <TextBlock x:Name="CardSubText" Style="{StaticResource CardSub}"
                                   Margin="0,4,0,0" Text="—"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="12,0,12,0">
                        <RadioButton x:Name="SortDur" GroupName="EqSort" Content="按时长"
                                     Style="{StaticResource SegButton}" Checked="OnSortDurationChecked"/>
                        <RadioButton x:Name="SortCnt" GroupName="EqSort" Content="按次数"
                                     Style="{StaticResource SegButton}" Checked="OnSortCountChecked"/>
                        <RadioButton x:Name="SortSt"  GroupName="EqSort" Content="按站别"
                                     Style="{StaticResource SegButton}" Checked="OnSortStationChecked"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="AI 解读" VerticalAlignment="Center"
                            Style="{StaticResource AiButton}" Click="OnAiClick"/>
                </Grid>

                <!--
                    行是动的（三种排序），所以整张表在后台代码里生成。
                    横向不给滚动条：给了 ScrollViewer 就按无限宽去量内容，
                    那几个 * 列会缩到最小宽，表反而不铺满了。
                -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SummaryGrid"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource OkBrush}"/>
                    <TextBlock Text="自动运行" FontSize="11" Foreground="{StaticResource MidBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource CritBrush}"/>
                    <TextBlock Text="报警停机" FontSize="11" Foreground="{StaticResource MidBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="= 该站自身停机" FontSize="11" Foreground="{StaticResource SoftBrush}"
                               VerticalAlignment="Center" Margin="6,0,16,0"/>

                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource NoDataBrush}"
                             Stroke="{StaticResource SoftBrush}" StrokeThickness="1"/>
                    <TextBlock Text="数据缺失" FontSize="11" Foreground="{StaticResource MidBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="通讯断连，状态未知" FontSize="11" Foreground="{StaticResource SoftBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
