<Window x:Class="DesktopPet.Ui.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:DesktopPet.Ui"
        Title="AI 解读" Width="880" Height="780"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
        无边框但不开 AllowsTransparency：那个会把整个窗口踢到软件渲染，
        滚长文档时肉眼可见地拖。WindowChrome 在 PresentationFramework 里，不用加引用。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource HairBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"    MinHeight="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"  MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource DarkBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Column="0"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 只在报警解析里出现：看完这一条，跳到它所在的那一栏去看全貌 -->
                    <Button x:Name="JumpButton" Grid.Column="1" Content="打开看板"
                            Visibility="Collapsed"
                            Style="{StaticResource ChatChip}"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Click="OnJumpClick"/>

                    <Button Grid.Column="2" Style="{StaticResource CloseX}"
                            Margin="0,0,5,0" VerticalAlignment="Center"
                            Click="OnCloseClick"/>
                </Grid>
            </Border>

            <!--
                正文。滚动条交给 FlowDocumentScrollViewer 自己管 —— 外面再套一层 ScrollViewer
                会让它拿到无限高度，量不出该多高，反而缩成一条。
            -->
            <Border Grid.Row="1" Margin="18,16,18,14"
                    Background="#FAFBFB"
                    BorderBrush="{StaticResource DarkBrush}" BorderThickness="3,0,0,0"
                    Padding="18,15,18,15">
                <Grid>
                    <!-- 先出现的那句话，900ms 后被正文顶掉 -->
                    <TextBlock x:Name="Waiting"
                               VerticalAlignment="Top"
                               FontSize="12" Foreground="{StaticResource SoftBrush}"
                               TextWrapping="Wrap"
                               Text="正在解读　·　规则引擎已算完，语言模型组织表述中…"/>

                    <FlowDocumentScrollViewer x:Name="Viewer"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False"
                                              Padding="0" Margin="0"/>
                </Grid>
            </Border>

            <!--
                GridSplitter 必须是 Grid 的直接子元素，而且要自己单独占一行 ——
                它是靠改相邻两行的 Height 来干活的，塞进别的容器里就找不到那两行了。
            -->
            <GridSplitter Grid.Row="2" Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Cursor="SizeNS"/>

            <!-- 读完接着问 -->
            <ui:ChatPanel x:Name="Chat" Grid.Row="3"/>

        </Grid>
    </Border>
</Window>
