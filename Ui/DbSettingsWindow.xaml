<Window x:Class="DesktopPet.Ui.DbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="数据库连接" Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0"
                            CornerRadius="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource HairBrush}" BorderThickness="1">
        <StackPanel>

            <!-- 标题栏 -->
            <Border Background="{StaticResource DarkBrush}" Height="40"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               Text="数据库连接"/>
                    <Button Style="{StaticResource CloseX}" HorizontalAlignment="Right"
                            Margin="0,0,7,0" VerticalAlignment="Center"
                            Click="OnCloseClick"/>
                </Grid>
            </Border>

            <StackPanel Margin="22,18,22,20">

                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource MidBrush}" Margin="0,0,0,16"
                           Text="报警和螺丝锁附的数据从本机 MySQL 读。密码不写进配置文件 —— 它存到 Windows 的「普通凭据」里，按当前用户加密，这台机器换个账号登录也读不出来。"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主机" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="HostBox"
                               Style="{StaticResource ChatInput}" Height="26" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PortBox"
                               Style="{StaticResource ChatInput}" Height="26" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="数据库" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DbBox"
                               Style="{StaticResource ChatInput}" Height="26" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="账号" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="UserBox"
                               Style="{StaticResource ChatInput}" Height="26" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="密码" VerticalAlignment="Center" FontSize="12"/>
                    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PassBox"
                                 Height="26" VerticalContentAlignment="Center"
                                 Padding="8,0" BorderBrush="{StaticResource HairBrush}"
                                 BorderThickness="1" Background="#FFFFFF"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="报警表" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TableBox"
                               Style="{StaticResource ChatInput}" Height="26" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 试连结果。没试过就是空的，不占位置。 -->
                <Border x:Name="ResultBox" Visibility="Collapsed" Margin="0,14,0,0"
                        Padding="10,7" CornerRadius="3">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="11.5"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="TestButton" Content="测试连接" Width="92" Height="30"
                            Margin="0,0,10,0" Click="OnTestClick"/>
                    <Button x:Name="SaveButton" Content="保存" Width="92" Height="30"
                            Click="OnSaveClick"/>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"
                           Foreground="{StaticResource MidBrush}"
                           Text="保存之后要重启程序才会重新取数 —— 本班的数据是开机时一次性算好的。"/>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
