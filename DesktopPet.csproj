    <!-- ============ MySqlConnector（唯一的第三方依赖）============
         报警和螺丝锁附直连本机 MySQL 用。装的是 MySqlConnector 2.6.2，
         它在 .NET Framework 4.8 上会带进 10 个依赖 dll，下面这一串全是它拖来的。

         **发布时这 11 个 dll 必须和 exe 一起拷走，少一个就是启动即崩。**
         所以「产物就一个 exe」那句话不成立了，要拷整个 bin\Release 文件夹。 -->
    <Reference Include="MySqlConnector">
      <HintPath>packages\MySqlConnector.2.6.2\lib\net48\MySqlConnector.dll</HintPath>
    </Reference>
